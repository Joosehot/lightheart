# Copy to .env and fill in the keys you have. .env is in .gitignore; keys never reach the browser.

# The chat (required)
ANTHROPIC_API_KEY=

# Comic book pictures (gpt-image-2); also OpenAI voice if chosen below (optional)
OPENAI_API_KEY=

# Voice mode on Gemini Live, the cheapest live voice (optional)
GEMINI_API_KEY=

# Optional settings
# LIGHTHEART_MODEL=claude-haiku-4-5-20251001     the chat model
# LIGHTHEART_STORY_MODEL=claude-sonnet-5-5       writes the comic book
# LIGHTHEART_IMAGE_QUALITY=low                   low / medium / high
# LIGHTHEART_VOICE_ENGINE=gemini                 gemini / openai
# LIGHTHEART_REALTIME_MODEL=gpt-realtime-2.1     or gpt-realtime-2.1-mini (about a third of the price)
# LIGHTHEART_DB=lightheart.db
